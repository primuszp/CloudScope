<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableSharpMetal Condition="'$(EnableSharpMetal)' == ''">true</EnableSharpMetal>
    <DefineConstants Condition="'$(EnableSharpMetal)' == 'true'">$(DefineConstants);ENABLE_SHARPMETAL</DefineConstants>
    <RootNamespace>CloudScope.CommandChecks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudScope\CloudScope.csproj" />
    <ProjectReference Include="..\CloudScope.Core\CloudScope.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSharpMetal)' == 'true'">
    <PackageReference Include="SharpMetal" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSharpMetal)' != 'true'">
    <Compile Remove="MetalGpuChecks.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
