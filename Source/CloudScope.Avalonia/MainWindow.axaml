<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CloudScope.Avalonia.MainWindow"
        Title="CloudScope"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        Background="{DynamicResource CsSurface}"
        FontFamily="{DynamicResource CsUiFont}">

  <Grid x:Name="WorkspaceGrid" RowDefinitions="30,Auto,*,70,24">
    <!-- Row 0 is collapsed on macOS, where the menu lives in the system menu bar. -->
    <Menu x:Name="MainMenuBar" Grid.Row="0" />

    <!-- Tool strip: unified with the titlebar on macOS, a flat command strip elsewhere. -->
    <Border x:Name="ToolStripBorder" Grid.Row="1"
            Background="{DynamicResource CsGraphite}"
            BorderBrush="{DynamicResource CsBorder}" BorderThickness="0,0,0,1">
      <StackPanel x:Name="ToolStripPanel" Orientation="Horizontal" Margin="10,6" Spacing="2" />
    </Border>

    <Grid x:Name="ContentGrid" Grid.Row="2" ColumnDefinitions="*,Auto,280">
      <Border Background="{DynamicResource CsViewportBackdrop}">
        <Grid>
          <ContentControl x:Name="ViewportHost" />
          <Border x:Name="ViewBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                  Background="{DynamicResource CsSurfaceDeep}" Opacity="0.82"
                  BorderBrush="{DynamicResource CsBorder}" BorderThickness="1"
                  CornerRadius="{DynamicResource CsCornerCard}" Padding="8,5">
            <StackPanel>
              <TextBlock x:Name="ViewBadgeTitle" Text="Perspective" Foreground="{DynamicResource CsText}"
                         FontSize="11" FontWeight="SemiBold" />
              <TextBlock x:Name="ViewBadgeSubtitle" Text="Single viewport" Classes="sectionTitle" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource CsBorder}"
                    ResizeDirection="Columns" />

      <Border Grid.Column="2" Background="{DynamicResource CsSurface}"
              BorderBrush="{DynamicResource CsBorder}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="InspectorPanel" Margin="12" Spacing="8" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Border x:Name="CommandLineBorder" Grid.Row="3" MinHeight="48"
            Background="{DynamicResource CsSurfaceDeep}"
            BorderBrush="{DynamicResource CsBorder}" BorderThickness="0,1,0,1">
      <ContentControl x:Name="CommandLineHost" />
    </Border>

    <!-- Declared after the command panel so it stays above it and receives the drag. -->
    <GridSplitter x:Name="CommandLineSplitter" Grid.Row="3" Height="6" VerticalAlignment="Top"
                  Background="Transparent" Cursor="SizeNorthSouth" ResizeDirection="Rows"
                  ZIndex="10" />

    <Border Grid.Row="4" Background="{DynamicResource CsSurfaceAlt}"
            BorderBrush="{DynamicResource CsBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="StatusPoints" Classes="statusItem" Text="No point cloud" />
        <TextBlock x:Name="StatusMode" Grid.Column="1" Classes="statusItem" Text="Navigate" />
        <TextBlock x:Name="StatusLabel" Grid.Column="2" Classes="statusItem" Text="Label: —" />
        <TextBlock x:Name="StatusProjection" Grid.Column="3" Classes="statusItem" Text="Perspective" />
        <TextBlock x:Name="StatusText" Grid.Column="4" Classes="statusItem" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusFps" Grid.Column="5" Classes="statusItem" Text="" />
      </Grid>
    </Border>
  </Grid>
</Window>
