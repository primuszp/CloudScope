<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CloudScope.Avalonia.MainWindow"
        Title="CloudScope"
        Width="1480"
        Height="920"
        MinWidth="1040"
        MinHeight="680"
        Background="{DynamicResource CsSurface}"
        FontFamily="{DynamicResource CsUiFont}">

  <!--
    A CAD workspace for point clouds, arranged the way AutoCAD and CloudCompare users expect:

      menu bar (system menu bar on macOS)
      ribbon — tabs over titled tool panels
      palettes (explorer tree over properties) | viewport header + viewport
      command window — transcript and live prompt
      status bar — counts, mode, drafting toggles, frame rate

    Every division between two resizable regions is drawn by the splitter that resizes it.
    Colours and metrics come from UiPalette through Cs* resources; shapes and states live in
    Themes/Controls.axaml. Everything interactive in this window submits a command string.
  -->
  <Grid x:Name="WorkspaceGrid" RowDefinitions="Auto,Auto,*,96,26">
    <!-- Row 0 is collapsed on macOS, where the menu lives in the system menu bar. -->
    <Menu x:Name="MainMenuBar" Grid.Row="0" />

    <ContentControl x:Name="RibbonHost" Grid.Row="1" />

    <Grid x:Name="ContentGrid" Grid.Row="2" ColumnDefinitions="300,Auto,*">
      <!-- Palette column: the explorer tree over the properties palette. -->
      <Border x:Name="PaletteColumn" Grid.Column="0" Classes="paletteColumn">
        <Grid x:Name="PaletteGrid" RowDefinitions="Auto,45*,Auto,55*">
          <Border x:Name="ExplorerHeader" Grid.Row="0" Classes="paletteHeader">
            <DockPanel>
              <StackPanel x:Name="ExplorerTools" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" />
              <TextBlock Text="EXPLORER" Classes="paletteTitle" />
            </DockPanel>
          </Border>
          <ContentControl x:Name="ExplorerHost" Grid.Row="1" />

          <!-- The splitter sits between the two star rows it trades height between; the
               properties header rides along with its palette. -->
          <GridSplitter x:Name="PaletteSplitter" Grid.Row="2" Classes="rowSeam" Height="5"
                        Background="Transparent" Cursor="SizeNorthSouth" ResizeDirection="Rows" />

          <DockPanel Grid.Row="3">
            <Border x:Name="PropertiesHeader" DockPanel.Dock="Top" Classes="paletteHeader">
              <DockPanel>
                <StackPanel x:Name="PropertiesTools" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" />
                <TextBlock Text="PROPERTIES" Classes="paletteTitle" />
              </DockPanel>
            </Border>
            <ContentControl x:Name="PropertiesHost" />
          </DockPanel>
        </Grid>
      </Border>

      <GridSplitter x:Name="PaletteColumnSplitter" Grid.Column="1" Classes="columnSeam"
                    Width="5" Background="Transparent" Cursor="SizeWestEast" ResizeDirection="Columns" />

      <!-- The drawing area: a header strip with the document tab and AutoCAD-style viewport
           controls, over the embedded GPU viewport. The controls live in the strip, not over
           the picture, because the viewport is a native child window that would hide them. -->
      <DockPanel x:Name="ViewportColumn" Grid.Column="2">
        <Border DockPanel.Dock="Top" Classes="viewportHeader">
          <DockPanel>
            <StackPanel x:Name="ViewportControls" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" />
            <Border Classes="documentTab">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ContentControl x:Name="DocumentIcon" VerticalAlignment="Center" />
                <TextBlock x:Name="DocumentTitle" Classes="documentTitle" Text="No point cloud" />
                <TextBlock x:Name="DocumentDetail" Classes="documentDetail" Text="" />
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>

        <!-- The embedded GL/Metal child window is borderless; this frame is the viewport's
             only visible edge. -->
        <Border Background="{DynamicResource CsViewportBackdrop}"
                BorderBrush="{DynamicResource CsViewportBorder}"
                BorderThickness="{DynamicResource CsViewportBorderThickness}">
          <ContentControl x:Name="ViewportHost" />
        </Border>
      </DockPanel>
    </Grid>

    <!-- The command console is one sunken well, bounded like AutoCAD's. -->
    <Border x:Name="CommandLineBorder" Grid.Row="3" MinHeight="48"
            Background="{DynamicResource CsSurfaceDeep}"
            BorderBrush="{DynamicResource CsBorder}" BorderThickness="0,0,0,1">
      <ContentControl x:Name="CommandLineHost" />
    </Border>

    <!-- Straddles the seam, so the line under the pointer is the line being dragged —
         AutoCAD's "drag the edge for more or fewer lines of history". -->
    <GridSplitter x:Name="CommandLineSplitter" Grid.Row="3" Classes="rowSeam"
                  Height="7" Margin="0,-3,0,0" VerticalAlignment="Top"
                  Background="Transparent" Cursor="SizeNorthSouth" ResizeDirection="Rows"
                  ZIndex="10" />

    <Border Grid.Row="4" Classes="statusBar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock x:Name="StatusPoints" Classes="statusItem" Text="No point cloud" />
        <TextBlock x:Name="StatusMode" Grid.Column="1" Classes="statusItem" Text="Navigate" />
        <TextBlock x:Name="StatusLabel" Grid.Column="2" Classes="statusItem" Text="Label: —" />
        <TextBlock x:Name="StatusText" Grid.Column="3" Classes="statusItem" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="StatusProgress" Grid.Column="4" Classes="statusProgress" IsVisible="False"
                     Minimum="0" Maximum="100" />
        <StackPanel x:Name="StatusToggles" Grid.Column="5" Orientation="Horizontal" Spacing="1"
                    VerticalAlignment="Center" Margin="8,0" />
        <TextBlock x:Name="StatusFps" Grid.Column="6" Classes="statusItem" MinWidth="48"
                   TextAlignment="Right" Text="" />
      </Grid>
    </Border>
  </Grid>
</Window>
