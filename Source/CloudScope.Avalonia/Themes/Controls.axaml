<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The CloudScope control theme: one neutral graphite-over-black surface set, hairline
    borders and no accent hue, layered over Fluent. Every colour and metric is a
    DynamicResource fed from CloudScope.Core/Ui/UiPalette, so this file describes shape and
    state, never the palette itself. See Docs/DesignSystem.md.
  -->

  <!-- Windows theme to the workspace surface unless a window sets its own. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsUiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>

  <!-- ── Buttons ─────────────────────────────────────────────────────────── -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorderStrong}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsAccentDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorderStrong}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
  </Style>

  <!-- ── Icons ───────────────────────────────────────────────────────────────
       Line icons take their stroke from the control they sit in, so a button's state (idle,
       active, disabled) recolours its drawing with no per-icon code. -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CsAccent}" />
  </Style>
  <Style Selector="Path.icon.filled">
    <Setter Property="Fill" Value="{DynamicResource CsAccent}" />
  </Style>
  <Style Selector=":disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CsTextFaint}" />
  </Style>
  <Style Selector="Button.active Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CsAccentBright}" />
  </Style>

  <!-- ── Ribbon ──────────────────────────────────────────────────────────────
       Tabs sit on the graphite band (the titlebar on macOS); the panels sit one tone down
       on the workspace surface, divided by hairlines, titles underneath like AutoCAD. -->
  <Style Selector="Border.ribbonTabRow">
    <Setter Property="Background" Value="{DynamicResource CsGraphite}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="ToggleButton.ribbonTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>
  <Style Selector="ToggleButton.ribbonTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>
  <Style Selector="ToggleButton.ribbonTab:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource CsAccentBright}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.ribbonTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
  </Style>
  <Style Selector="Button.ribbonCollapse">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ribbonBody">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="100" />
  </Style>
  <Style Selector="Border.ribbonPanel">
    <Setter Property="Padding" Value="6,6,6,0" />
  </Style>
  <Style Selector="Border.ribbonPanelSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Background" Value="{DynamicResource CsBorder}" />
  </Style>
  <Style Selector="TextBlock.ribbonPanelTitle">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,4" />
  </Style>

  <Style Selector="Button.ribbonLarge, Button.ribbonSmall">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>
  <Style Selector="Button.ribbonLarge">
    <Setter Property="Padding" Value="6,6,6,4" />
    <Setter Property="MinWidth" Value="54" />
    <Setter Property="Height" Value="70" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbonLarge TextBlock.ribbonCaption">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="72" />
  </Style>
  <Style Selector="Button.ribbonSmall">
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="Height" Value="23" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ribbonCaption">
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbonLarge:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ribbonSmall:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
  </Style>
  <Style Selector="Button.ribbonLarge:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ribbonSmall:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsAccentDim}" />
  </Style>
  <Style Selector="Button.ribbonLarge.active /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ribbonSmall.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsAccentDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:disabled TextBlock.ribbonCaption">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
  </Style>
  <Style Selector="Button.ribbonLarge:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ribbonSmall:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.tipTitle">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
  </Style>
  <Style Selector="TextBlock.tipCommand">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
  </Style>

  <!-- ── Palettes (explorer / properties) ──────────────────────────────────── -->
  <Style Selector="Border.paletteColumn">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
  </Style>
  <Style Selector="Border.paletteHeader">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceAlt}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,0,4,0" />
  </Style>
  <Style Selector="TextBlock.paletteTitle">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.paletteTool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.paletteTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
  </Style>

  <!-- Explorer tree -->
  <Style Selector="TreeView.explorerTree">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="TreeView.explorerTree TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="2,0,6,0" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>
  <Style Selector="TreeView.explorerTree TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="TreeView.explorerTree TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
  </Style>
  <Style Selector="TreeView.explorerTree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource CsSelectionFill}" />
  </Style>
  <Style Selector="TreeView.explorerTree TreeViewItem:selected:focus-within /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource CsAccentDim}" />
  </Style>
  <Style Selector="TextBlock.explorerName">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.explorerName.group">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
  </Style>
  <Style Selector="TextBlock.explorerName.active">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CsAccentBright}" />
  </Style>
  <Style Selector="TextBlock.explorerName.dim">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
  </Style>
  <Style Selector="TextBlock.explorerDetail">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,2,0" />
    <Setter Property="MaxWidth" Value="120" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.explorerHint">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Button.explorerEye">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>
  <Style Selector="Button.explorerEye.off Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CsTextFaint}" />
  </Style>
  <Style Selector="Button.explorerEye:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
  </Style>

  <!-- Properties palette -->
  <Style Selector="StackPanel.propertyList">
    <Setter Property="Margin" Value="12,8,12,12" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="StackPanel.propertyHeader">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.propertyHeaderText">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.propertySection">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Margin" Value="0,8,0,2" />
  </Style>
  <Style Selector="Grid.propertyRow">
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.propertyChoice">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="Padding" Value="8,2,6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="CheckBox.propertyToggle">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Slider.propertySlider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-6,0,-6" />
  </Style>
  <Style Selector="TextBox.propertyInput">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="WrapPanel.propertyActions">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.propertyAction">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ── Viewport header ────────────────────────────────────────────────────── -->
  <Style Selector="Border.viewportHeader">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0,0,6,0" />
  </Style>
  <Style Selector="Border.documentTab">
    <Setter Property="Background" Value="{DynamicResource CsViewportBackdrop}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="6,4,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.documentTitle">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.documentDetail">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.viewportControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.viewportControl:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   Button.propertyChoice:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.viewportControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>

  <!-- ── Status bar ─────────────────────────────────────────────────────────── -->
  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceAlt}" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Button.statusToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.statusToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>
  <Style Selector="Button.statusToggle.active">
    <Setter Property="Foreground" Value="{DynamicResource CsAccentBright}" />
  </Style>
  <Style Selector="Button.statusToggle.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsAccentDim}" />
  </Style>
  <Style Selector="Border.statusSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,5" />
    <Setter Property="Background" Value="{DynamicResource CsBorder}" />
  </Style>
  <Style Selector="ProgressBar.statusProgress">
    <Setter Property="Width" Value="140" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Foreground" Value="{DynamicResource CsAccent}" />
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
  </Style>

  <!-- The command window's close / history rail. -->
  <Style Selector="Button.commandRailButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.commandRailButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>

  <!-- A keyword sits inside the prompt's own "[...]", on the text baseline, not a button
       dropped into a sentence. -->
  <Style Selector="Button.keywordLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
  </Style>
  <Style Selector="Button.keywordLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CsAccent}" />
  </Style>
  <Style Selector="Button.keywordLink.defaultKeyword">
    <Setter Property="Foreground" Value="{DynamicResource CsAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ── Text ────────────────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.prompt">
    <Setter Property="Foreground" Value="{DynamicResource CsAccent}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.propertyName">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.propertyValue">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.statusItem">
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
  </Style>

  <!-- ── Text input ──────────────────────────────────────────────────────── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>
  <Style Selector="TextBox.commandInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="CaretBrush" Value="{DynamicResource CsAccent}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeMono}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ── Menus ───────────────────────────────────────────────────────────── -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource CsGraphite}" />
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeBody}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource CsSelectionFill}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerCard}" />
  </Style>

  <!-- ── Lists ───────────────────────────────────────────────────────────── -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource CsText}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSelectionFill}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceHover}" />
  </Style>

  <!-- ── Chrome ──────────────────────────────────────────────────────────── -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- ── Panel seams ─────────────────────────────────────────────────────────
       A seam between two workspace panels is drawn by the splitter that resizes it, so the
       line the eye reads as the division is exactly the line the pointer can grab. At rest
       it is one hairline; under the pointer it lifts to the strong tone and a short grip
       appears in the middle of the run, the way AutoCAD's command window announces that its
       top edge can be dragged for more or fewer lines of history. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="GridSplitter.rowSeam">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border x:Name="Seam" Height="1" VerticalAlignment="Center"
                  Background="{DynamicResource CsBorder}">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.10" /></Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="Grip" Width="36" Height="3" Opacity="0" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{DynamicResource CsBorderStrong}">
            <Border.Transitions>
              <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.10" /></Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="GridSplitter.columnSeam">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border x:Name="Seam" Width="1" HorizontalAlignment="Center"
                  Background="{DynamicResource CsBorder}">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.10" /></Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="Grip" Width="3" Height="36" Opacity="0" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{DynamicResource CsBorderStrong}">
            <Border.Transitions>
              <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.10" /></Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="GridSplitter.rowSeam:pointerover /template/ Border#Seam,
                   GridSplitter.columnSeam:pointerover /template/ Border#Seam">
    <Setter Property="Background" Value="{DynamicResource CsBorderStrong}" />
  </Style>
  <Style Selector="GridSplitter.rowSeam:pointerover /template/ Border#Grip,
                   GridSplitter.columnSeam:pointerover /template/ Border#Grip">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ── Command window ──────────────────────────────────────────────────────
       The transcript is a sunken well; the live command row sits one tone above it,
       divided by a single hairline. That hairline is the only line in the panel, and it
       brightens while the caret is in the input, so the row you type into is the row that
       is lit. -->
  <Style Selector="Border.commandInputRow">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,5,10,6" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.10" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.commandInputRow.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorderStrong}" />
  </Style>

  <!-- The chevron that marks where typing goes, quiet until the row has focus. -->
  <Style Selector="TextBlock.commandChevron">
    <Setter Property="Foreground" Value="{DynamicResource CsTextFaint}" />
    <Setter Property="FontFamily" Value="{DynamicResource CsMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource CsFontSizeMono}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,7,0" />
  </Style>
  <Style Selector="Border.commandInputRow.focused TextBlock.commandChevron">
    <Setter Property="Foreground" Value="{DynamicResource CsAccent}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CsSurfaceDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource CsTextDim}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerControl}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- A framed content group: inspector cards, dialog sections. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CsSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CsBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CsCornerCard}" />
  </Style>
</Styles>
