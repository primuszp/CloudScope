<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableSharpMetal Condition="'$(EnableSharpMetal)' == ''">true</EnableSharpMetal>
    <EnableImGui Condition="'$(EnableImGui)' == ''">true</EnableImGui>
    <DefineConstants Condition="'$(EnableSharpMetal)' == 'true'">$(DefineConstants);ENABLE_SHARPMETAL</DefineConstants>
    <DefineConstants Condition="'$(EnableImGui)' == 'true'">$(DefineConstants);ENABLE_IMGUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpMetal" PrivateAssets="all" Condition="'$(EnableSharpMetal)' == 'true'" />
    <PackageReference Include="ImGui.NET" PrivateAssets="all" Condition="'$(EnableImGui)' == 'true'" />
    <PackageReference Include="OpenTK" />
    <PackageReference Include="OpenTK.Core" />
    <PackageReference Include="OpenTK.Mathematics" />
    <PackageReference Include="OpenTK.Windowing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudScope.Core\CloudScope.Core.csproj" />
    <ProjectReference Include="..\CloudScope.MacOS\CloudScope.MacOS.csproj" Condition="'$(EnableSharpMetal)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableSharpMetal)' != 'true'">
    <Compile Remove="Platform\Metal\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CloudScope.Avalonia</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudScope.CommandChecks" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableImGui)' != 'true'">
    <Compile Remove="Platform\OpenGL\ImGuiController.cs" />
    <Compile Remove="Ui\CommandLineOverlay.cs" />
    <Compile Remove="Ui\ImGuiTheme.cs" />
  </ItemGroup>

</Project>
